modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "map-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "account-regression"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "map-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PLAYWRIGHT_CHROMIUM_EXECUTABLE=\"$(command -v chromium)\" pnpm --filter @workspace/buurtgids exec playwright test e2e/discovery-regression.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "account-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CLERK_LIVE_SIGNUP=1 CLERK_LIVE_BASE_URL=\"https://$REPLIT_DEV_DOMAIN\" PLAYWRIGHT_CHROMIUM_EXECUTABLE=\"$(command -v chromium)\" pnpm --filter @workspace/buurtgids exec playwright test e2e/clerk-live-signup.spec.ts e2e/account-preferences.spec.ts e2e/consumer-registration.spec.ts e2e/signup-stale-step.spec.ts"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[userenv]

[userenv.development]
ACCOUNTS_ENABLED = "true"
VITE_ACCOUNTS_ENABLED = "true"
BUSINESS_INTAKE_ENABLED = "true"
VITE_BUSINESS_INTAKE_ENABLED = "true"
BUSINESS_PUBLICATION_ENABLED = "true"
VITE_BUSINESS_PUBLICATION_ENABLED = "true"
CONSUMER_REGISTRATION_ENABLED = "true"
VITE_CONSUMER_REGISTRATION_ENABLED = "true"
