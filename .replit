modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[userenv]

[userenv.development]
ACCOUNTS_ENABLED = "true"
VITE_ACCOUNTS_ENABLED = "true"
BUSINESS_INTAKE_ENABLED = "true"
VITE_BUSINESS_INTAKE_ENABLED = "true"
BUSINESS_PUBLICATION_ENABLED = "true"
VITE_BUSINESS_PUBLICATION_ENABLED = "true"
